{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "carbonledger-backend", "region": "asia-southeast1" } },
      { "source": "/factors/**", "run": { "serviceId": "carbonledger-backend", "region": "asia-southeast1" } },
      { "source": "/factors", "run": { "serviceId": "carbonledger-backend", "region": "asia-southeast1" } }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/factors/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ]
  }
}
