# Public Firebase web configuration — injected into the Vite bundle at build
# time (Vite auto-loads frontend/.env). These values are public by design:
# they ship inside the deployed JS bundle of any Firebase web app. The file is
# still gitignored, so copy it to frontend/.env and fill in your own project.
# Without it the SPA runs, just without an anonymous identity.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
