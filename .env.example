# CarbonLedger backend — environment template.
# Copy to .env and fill in real values. .env is gitignored: never commit it.
# The backend reads plain environment variables, so load the copy into your
# shell first (e.g. `set -a; source .env; set +a`) or run node with
# `--env-file=.env`. All entries below except the secrets are optional.

# --- Secrets (no defaults) ---
# Unset GEMINI_API_KEY makes the AI layer run the offline mock adapter.
GEMINI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json   # optional: ADC for Firestore/Storage

# --- Deployment switches (defaults shown; uncomment to override) ---
# Production (Cloud Run) uses: STORE_KIND=firestore, STORAGE_KIND=firebase
# AI_MODE=real                  # real | mock (unset: real iff GEMINI_API_KEY is set)
# STORE_KIND=local              # local | firestore
# STORAGE_KIND=local            # local | firebase
# STORAGE_BUCKET_NAME=carbonledger-files
# GCP_PROJECT_ID=carbonledger
# AI_TIMEOUT_SECONDS=60
# DEFAULT_GWP_VERSION=AR6       # AR5 | AR6

# --- Server tuning (all optional, defaults shown) ---
# PORT=8080
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_PER_MIN=60
# TRUST_PROXY=1                 # set to 1 behind a trusted reverse proxy so the rate limiter honours X-Forwarded-For
# PIPELINE_CONCURRENCY=4
# RECALL_CHANNEL=both           # both | keyword | semantic
# STORE_ROOT=data/.local-store
# STORAGE_ROOT=data/.uploads
